# Rust build artifacts
/target
**/*.rs.bk
*.pdb

# Cargo lock is committed for the top-level workspace (binaries); keep it.
# (No exclusion here — Cargo.lock is intentionally tracked.)

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Installer build artifacts (scripts + .iss are tracked; outputs are not)
/installer/Output/
/installer/stage/

# CLI scratch output
/tmp-out.csv
/out.csv
/out.xlsx
/out.png
/*.png

# Native WinUI / CMake build trees (source under native/ is tracked)
native/**/build*/
native/**/build-*/
*.dll
!logo/**
