# Normalize text files to LF in the repository.
* text=auto eol=lf

# Golden-test fixtures are byte-exact contracts: the takeoff writer emits LF,
# so these must stay LF in the working tree on every platform. Without this,
# core.autocrlf=true rewrites them to CRLF on Windows checkout and
# `takeoff_matches_golden_csv` fails on line endings alone.
*.csv text eol=lf
*.dxf text eol=lf
*.aadt text eol=lf
