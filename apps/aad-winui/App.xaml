<Application
    x:Class="Aad.WinUi.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/ColorTokens.xaml" />
                <ResourceDictionary Source="Themes/TypographyTokens.xaml" />
                <ResourceDictionary Source="Themes/SpacingTokens.xaml" />
                <ResourceDictionary Source="Themes/ControlTokens.xaml" />
                <ResourceDictionary Source="Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Restrained Windows blue accent (Fluent). Drives selection, toggles, and focus rings. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#0078D4</Color>
                    <Color x:Key="SystemAccentColorLight1">#1890E0</Color>
                    <Color x:Key="SystemAccentColorLight2">#2B9AE8</Color>
                    <Color x:Key="SystemAccentColorLight3">#60B6F0</Color>
                    <Color x:Key="SystemAccentColorDark1">#006CBE</Color>
                    <Color x:Key="SystemAccentColorDark2">#005A9E</Color>
                    <Color x:Key="SystemAccentColorDark3">#004578</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#60CDFF</Color>
                    <Color x:Key="SystemAccentColorLight1">#60CDFF</Color>
                    <Color x:Key="SystemAccentColorLight2">#8AD4FF</Color>
                    <Color x:Key="SystemAccentColorLight3">#B0E0FF</Color>
                    <Color x:Key="SystemAccentColorDark1">#3BB0E8</Color>
                    <Color x:Key="SystemAccentColorDark2">#1A8FCF</Color>
                    <Color x:Key="SystemAccentColorDark3">#0078D4</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
