<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Defaults are always-installed faces. ShellFonts.Resolve upgrades to Variable/Cascadia when present. -->
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBody">12</x:Double>
    <x:Double x:Key="FontSizeButton">12</x:Double>
    <x:Double x:Key="FontSizeLabel">12</x:Double>
    <x:Double x:Key="FontSizeCommand">13</x:Double>
    <x:Double x:Key="FontSizeMono">12</x:Double>
    <x:Double x:Key="FontSizeSection">14</x:Double>
    <x:Double x:Key="FontSizeHeading">16</x:Double>
    <x:Double x:Key="FontSizePageTitle">24</x:Double>
    <x:Double x:Key="FontSizeSplashTitle">28</x:Double>
    <FontFamily x:Key="FontFamilyUi">Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Consolas</FontFamily>
</ResourceDictionary>
