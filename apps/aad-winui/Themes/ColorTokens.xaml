<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Premium CAD + Fluent surfaces.
      Dark: graphite/charcoal. Light: neutral off-white.
      Accent: restrained Windows blue. Canvas stays independently black/white.
      Command chrome stays opaque (no acrylic) so the HWND drawing child stays readable.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#F9F9F9" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#EEEEEE" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceStatusBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C5C5C" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#8A8A8A" />
            <SolidColorBrush x:Key="BorderDefaultBrush" Color="#D1D1D1" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E6E6E6" />
            <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#E8E8E8" />
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#DCDCDC" />
            <SolidColorBrush x:Key="ControlSelectedBrush" Color="#CDE4F7" />
            <SolidColorBrush x:Key="FocusBorderBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="ControlDisabledBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CommandChromeBrush" Color="#FAFFFFFF" />
            <SolidColorBrush x:Key="CommandChromeCadBrush" Color="#FAF7F7F7" />
            <SolidColorBrush x:Key="CommandChromeAccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="CadChannelBrush" Color="#0F7B3A" />
            <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B3A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#9A6700" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="DestructiveBrush" Color="#C42B1C" />
            <Color x:Key="TitleBarBackgroundColor">#F3F3F3</Color>
            <Color x:Key="TitleBarForegroundColor">#1A1A1A</Color>
            <Color x:Key="TitleBarInactiveForegroundColor">#5C5C5C</Color>
            <Color x:Key="TitleBarHoverColor">#E8E8E8</Color>
            <Color x:Key="TitleBarPressedColor">#DCDCDC</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1B1B1B" />
