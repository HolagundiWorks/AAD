            <SolidColorBrush x:Key="ControlPressedBrush" Color="#383838" />
            <SolidColorBrush x:Key="ControlSelectedBrush" Color="#1A3B5C" />
            <SolidColorBrush x:Key="FocusBorderBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="ControlDisabledBrush" Color="#6B6B6B" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="CommandChromeBrush" Color="#F21F1F1F" />
            <SolidColorBrush x:Key="CommandChromeCadBrush" Color="#F2282828" />
            <SolidColorBrush x:Key="CommandChromeAccentBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="CadChannelBrush" Color="#6CCB8A" />
