            <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="DestructiveBrush" Color="#FF99A4" />
            <Color x:Key="TitleBarBackgroundColor">#1B1B1B</Color>
