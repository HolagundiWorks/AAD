<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 4 px scale (+ SpaceXs = 2 for compact technical rows). -->
    <x:Double x:Key="SpaceXs">2</x:Double>
    <x:Double x:Key="SpaceSm">4</x:Double>
    <x:Double x:Key="SpaceMd">8</x:Double>
    <x:Double x:Key="SpaceLg">12</x:Double>
    <x:Double x:Key="SpaceXl">16</x:Double>
    <x:Double x:Key="SpaceXxl">24</x:Double>

    <Thickness x:Key="PaddingNone">0</Thickness>
    <Thickness x:Key="PaddingXs">2</Thickness>
    <Thickness x:Key="PaddingSm">4</Thickness>
    <Thickness x:Key="PaddingMd">8</Thickness>
    <Thickness x:Key="PaddingLg">12</Thickness>
    <Thickness x:Key="PaddingDialog">12</Thickness>
    <Thickness x:Key="PaddingPanel">8</Thickness>
    <Thickness x:Key="PaddingPanelTight">8,8,8,4</Thickness>
    <Thickness x:Key="PaddingCommandBar">12,8</Thickness>
    <Thickness x:Key="PaddingStatus">12,4,12,8</Thickness>
    <Thickness x:Key="MarginLabelField">0,0,0,2</Thickness>
    <Thickness x:Key="MarginSection">0,0,0,12</Thickness>
</ResourceDictionary>
