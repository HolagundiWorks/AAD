<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Desktop developer-app targets: WCAG 2.2 floor 32 DIP for custom buttons. -->
    <x:Double x:Key="ControlHeight">32</x:Double>
    <x:Double x:Key="ControlHeightCompact">28</x:Double>
    <x:Double x:Key="IconButtonSize">32</x:Double>
    <x:Double x:Key="IconSize">20</x:Double>
    <x:Double x:Key="IconSizeSm">16</x:Double>
    <x:Double x:Key="SplitterWidth">8</x:Double>
    <x:Double x:Key="FileTabHeight">40</x:Double>
    <x:Double x:Key="SidePanelWidth">280</x:Double>
    <x:Double x:Key="CornerRadiusSm">3</x:Double>
    <x:Double x:Key="CornerRadiusMd">4</x:Double>
    <Thickness x:Key="BorderThicknessNone">0</Thickness>
    <Thickness x:Key="BorderThicknessHairline">1</Thickness>
    <CornerRadius x:Key="CornerRadiusControl">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusChrome">3</CornerRadius>
</ResourceDictionary>
