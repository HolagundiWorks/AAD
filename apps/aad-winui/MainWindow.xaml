<Window
    x:Class="Aad.WinUi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aad.WinUi"
    Title="O-Draft">
    <Grid x:Name="ShellRoot" Loaded="OnLoaded" PreviewKeyDown="OnShellKey" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ToolRow" Height="0" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptLive" Width="0" Height="0" Opacity="0" IsHitTestVisible="False" AutomationProperties.Name="Command prompt" />
        <MenuBar x:Name="Bar" Background="{ThemeResource SurfaceBrush}" AutomationProperties.Name="Menu" />
        <TabView x:Name="FileTabs" Grid.Row="1" Height="{StaticResource FileTabHeight}" VerticalAlignment="Top" Background="{ThemeResource SurfaceBrush}" IsAddTabButtonVisible="True" AddTabButtonClick="OnNewDrawingTab" TabCloseRequested="OnDrawingTabClose" SelectionChanged="OnDrawingTabSelected" CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent" AutomationProperties.Name="Open drawings" />
        <Border Grid.Row="3" Height="1" Background="{ThemeResource BorderSubtleBrush}" />
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ToolColumn" Width="Auto" />
                <ColumnDefinition x:Name="PropertiesColumn" Width="280" MinWidth="0" />
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="120" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ToolStripHost" Style="{StaticResource ToolStripChromeStyle}" AutomationProperties.Name="Tool strip">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ToolStrip" Orientation="Vertical" Spacing="{StaticResource SpaceSm}" Margin="{StaticResource PaddingSm}" />
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SidePanelChromeStyle}">
            <Grid x:Name="LeftColumn" PointerEntered="OnColumnEntered" PointerExited="OnColumnExited" Tag="left" AutomationProperties.Name="Side panel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="{StaticResource PaddingPanelTight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ContextBar" Spacing="{StaticResource SpaceSm}">
                        <TextBlock Text="Layer" Style="{StaticResource MutedCaptionStyle}" />
                        <ComboBox x:Name="LayerBox" HorizontalAlignment="Stretch" MinHeight="{StaticResource ControlHeight}" SelectionChanged="OnLayerPicked" AutomationProperties.Name="Current layer" />
                        <TextBlock Text="Floor" Style="{StaticResource MutedCaptionStyle}" />
                        <ComboBox x:Name="FloorBox" HorizontalAlignment="Stretch" MinHeight="{StaticResource ControlHeight}" SelectionChanged="OnFloorPicked" AutomationProperties.Name="Current floor" />
                        <TextBlock Text="Drawing space" Style="{StaticResource MutedCaptionStyle}" />
                        <ComboBox x:Name="SpaceBox" HorizontalAlignment="Stretch" MinHeight="{StaticResource ControlHeight}" PlaceholderText="No saved drawing space" SelectionChanged="OnSpacePicked" AutomationProperties.Name="Drawing space" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Top">
                        <Button x:Name="FloatLeftButton" Style="{StaticResource IconButtonStyle}" Click="OnFloat" AutomationProperties.Name="Float side panels" ToolTipService.ToolTip="Float side panels">
                            <local:DrawnIcon Kind="float" Width="{StaticResource IconSize}" Height="{StaticResource IconSize}" />
                        </Button>
                        <Button x:Name="PinLeftButton" Style="{StaticResource IconButtonStyle}" Click="OnPin" AutomationProperties.Name="Pin side panel" ToolTipService.ToolTip="Pin side panel">
                            <local:DrawnIcon Kind="pin" Width="{StaticResource IconSize}" Height="{StaticResource IconSize}" />
                        </Button>
                    </StackPanel>
                </Grid>
                <TabView x:Name="SideTabs" Grid.Row="1" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" TabWidthMode="Equal">
                    <TabViewItem x:Name="PropertiesTab" Header="Properties" IsClosable="False">
                        <ScrollViewer x:Name="PropertiesHost">
                            <StackPanel x:Name="PropertiesPanel" Margin="{StaticResource PaddingMd}" Spacing="{StaticResource SpaceSm}" />
                        </ScrollViewer>
                    </TabViewItem>
                    <TabViewItem x:Name="LayersTab" Header="Layer manager" IsClosable="False">
                        <Grid x:Name="LayersSlot">
                            <ScrollViewer x:Name="LayersHost">
                                <StackPanel x:Name="LayersPanel" Margin="{StaticResource PaddingMd}" Spacing="{StaticResource SpaceSm}" />
                            </ScrollViewer>
                        </Grid>
                    </TabViewItem>
                    <TabViewItem x:Name="BlocksTab" Header="Blocks" IsClosable="False">
                        <ScrollViewer x:Name="BlocksHost">
                            <StackPanel x:Name="BlocksPanel" Margin="{StaticResource PaddingMd}" Spacing="{StaticResource SpaceSm}" />
                        </ScrollViewer>
                    </TabViewItem>
                </TabView>
            </Grid>
            </Border>
            <!-- Control with a Border template so Background is hit-testable (empty Control was not). -->
            <local:ResizeGrip x:Name="LeftSplitter" Grid.Column="2" Width="{StaticResource SplitterWidth}" MinWidth="{StaticResource SplitterWidth}" Background="{ThemeResource BorderDefaultBrush}" PointerPressed="OnSplitPressed" PointerMoved="OnSplitMoved" PointerReleased="OnSplitReleased" PointerCaptureLost="OnSplitCaptureLost" KeyDown="OnSplitKey" AutomationProperties.Name="Resize side panel" ToolTipService.ToolTip="Drag, or Left and Right arrows when focused" />
            <Border x:Name="CanvasHost" Grid.Column="3" Background="{ThemeResource CanvasBackgroundBrush}" SizeChanged="OnCanvasSize" AutomationProperties.Name="Drawing" />
            <Grid x:Name="StartPage" Grid.Column="3" Visibility="Collapsed" Background="{ThemeResource AppBackgroundBrush}" AutomationProperties.Name="Start">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource SpaceMd}">
                    <Image x:Name="StartLogo" Width="72" Height="72" HorizontalAlignment="Center" AutomationProperties.Name="O-Draft" />
                    <TextBlock x:Name="StartHeading" Text="O-Draft" FontSize="{StaticResource FontSizePageTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="Drafting. Part of OSAS, the Open Source Architecture Suite." Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="{StaticResource MarginSection}" />
                    <Button Content="New drawing" Click="OnStartNew" AutomationProperties.Name="New drawing" />
                    <Button Content="Open drawing" Click="OnStartOpen" AutomationProperties.Name="Open drawing" />
                    <Button Content="Back to the drawing" Click="OnStartClose" AutomationProperties.Name="Back to the drawing" />
                </StackPanel>
            </Grid>
        </Grid>
        <Border x:Name="CommandBar" Visibility="Collapsed" Padding="{StaticResource PaddingCommandBar}" CornerRadius="{StaticResource CornerRadiusControl}" BorderThickness="0,2,0,0" BorderBrush="{ThemeResource CommandChromeAccentBrush}" Background="{ThemeResource CommandChromeBrush}" PreviewKeyDown="OnAiKey" PointerPressed="OnBarPressed" PointerMoved="OnBarMoved" PointerReleased="OnBarReleased" AutomationProperties.Name="AI command prompt">
            <Grid RowSpacing="{StaticResource SpaceSm}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="RecentHost" Background="Transparent" AutomationProperties.Name="Command history preview">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="Recent0" FontSize="{StaticResource FontSizeBody}" LineHeight="16" Foreground="{ThemeResource TextSecondaryBrush}" FontFamily="{StaticResource FontFamilyMono}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                    <TextBlock x:Name="Recent1" Grid.Row="1" FontSize="{StaticResource FontSizeBody}" LineHeight="16" Foreground="{ThemeResource TextPrimaryBrush}" FontFamily="{StaticResource FontFamilyMono}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                </Grid>
                <TextBlock x:Name="PromptLabel" Grid.Row="1" Style="{StaticResource AiChannelLabelStyle}" Text="Ask:" TextTrimming="CharacterEllipsis" />
                <Grid Grid.Row="2" ColumnSpacing="{StaticResource SpaceXs}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AiInput" FontFamily="{StaticResource FontFamilyUi}" FontSize="{StaticResource FontSizeCommand}" MinHeight="{StaticResource ControlHeight}" BorderThickness="{StaticResource BorderThicknessNone}" Background="Transparent" Padding="0,6,8,6" VerticalAlignment="Center" PlaceholderText="Ask about the drawing…" AutomationProperties.Name="AI prompt">
                        <TextBox.Resources>
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                    <Button x:Name="HistoryToggle" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Background="Transparent" BorderThickness="{StaticResource BorderThicknessNone}" CornerRadius="{StaticResource CornerRadiusControl}" Click="OnHistoryToggle" AutomationProperties.Name="Command history" ToolTipService.ToolTip="Command history">
                        <FontIcon x:Name="HistoryGlyph" Glyph="&#xE70D;" FontSize="{StaticResource FontSizeBody}" />
                    </Button>
                    <Button x:Name="ClearHistory" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="Transparent" BorderThickness="{StaticResource BorderThicknessNone}" CornerRadius="{StaticResource CornerRadiusControl}" Click="OnClearHistory" AutomationProperties.Name="Clear history" ToolTipService.ToolTip="Clear history">
                        <local:DrawnIcon Kind="delete" />
                    </Button>
                    <StackPanel x:Name="AssistantButtons" Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center" Visibility="Collapsed">
                        <Button Content="Allow" MinHeight="{StaticResource ControlHeight}" MinWidth="72" Click="OnAssistantAllow" AutomationProperties.Name="Allow the assistant tool" />
                        <Button Content="Decline" MinHeight="{StaticResource ControlHeight}" MinWidth="72" Click="OnAssistantDecline" AutomationProperties.Name="Decline the assistant tool" />
                    </StackPanel>
                </Grid>
                <ListView x:Name="HistoryList" Grid.Row="3" MaxHeight="240" Visibility="Collapsed" Background="Transparent" BorderThickness="{StaticResource BorderThicknessNone}" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeBody}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnHistoryPick" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Command history list">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
                            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <TextBlock x:Name="History" Visibility="Collapsed" />
            </Grid>
        </Border>
        <Border Grid.Row="7" Background="{ThemeResource SurfaceStatusBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
        <Grid x:Name="StatusRow" Padding="{StaticResource PaddingStatus}" ColumnSpacing="{StaticResource SpaceMd}" AutomationProperties.Name="Status">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                    <Button Click="OnNewLayout" AutomationProperties.Name="New layout" ToolTipService.ToolTip="New layout" Style="{StaticResource IconButtonStyle}">
                        <local:DrawnIcon Kind="plus" />
                    </Button>
                    <StackPanel x:Name="LayoutTabs" Orientation="Horizontal" Spacing="{StaticResource SpaceXs}" />
                    <TextBlock x:Name="Coords" VerticalAlignment="Center" Margin="8,0,0,0" FontFamily="{StaticResource FontFamilyMono}" FontSize="{StaticResource FontSizeMono}" AutomationProperties.Name="Cursor coordinates" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <ToggleButton x:Name="SnapButton" Tag="osnap" Click="OnMode" AutomationProperties.Name="Object snap (F3)" ToolTipService.ToolTip="Object snap (F3)" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="osnap" />
                </ToggleButton>
                <ToggleButton x:Name="OrthoButton" Tag="ortho" Click="OnMode" AutomationProperties.Name="Ortho mode (F8)" ToolTipService.ToolTip="Ortho (F8)" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="ortho" />
                </ToggleButton>
                <ToggleButton x:Name="PolarButton" Tag="polar" Click="OnMode" AutomationProperties.Name="Polar tracking (F10)" ToolTipService.ToolTip="Polar tracking (F10)" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="polar" />
                </ToggleButton>
                <ToggleButton x:Name="TrackButton" Tag="otrack" Click="OnMode" AutomationProperties.Name="Object snap tracking (F11)" ToolTipService.ToolTip="Object snap tracking (F11)" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="otrack" />
                </ToggleButton>
                <ToggleButton x:Name="DynButton" Tag="dynmode" Click="OnMode" AutomationProperties.Name="Dynamic input (F12)" ToolTipService.ToolTip="Dynamic input (F12)" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="dyn" />
                </ToggleButton>
                <ToggleButton x:Name="WeightButton" Tag="lwdisplay" Click="OnMode" AutomationProperties.Name="Show lineweight" ToolTipService.ToolTip="Lineweight" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="lineweight" />
                </ToggleButton>
                <ToggleButton x:Name="TransparencyButton" Tag="transparencydisplay" Click="OnMode" AutomationProperties.Name="Show transparency" ToolTipService.ToolTip="Transparency" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="transparency" />
                </ToggleButton>
                <ToggleButton x:Name="QuickButton" Tag="qpmode" Click="OnMode" AutomationProperties.Name="Quick properties" ToolTipService.ToolTip="Quick properties" Style="{StaticResource IconToggleButtonStyle}">
                    <local:DrawnIcon Kind="quickprops" />
                </ToggleButton>
                <Button x:Name="UnitsButton" Content="Units" MinHeight="{StaticResource ControlHeight}" Click="OnUnits" AutomationProperties.Name="Drawing units and plot" />
                <Button x:Name="LayersButton" Click="OnLayers" AutomationProperties.Name="Open layer manager" ToolTipService.ToolTip="Layers" Style="{StaticResource IconButtonStyle}">
                    <local:DrawnIcon Kind="layers" />
                </Button>
                <Button x:Name="PdfButton" Click="OnPdf" AutomationProperties.Name="PDF preview" ToolTipService.ToolTip="PDF" Style="{StaticResource IconButtonStyle}">
                    <local:DrawnIcon Kind="pdf" />
                </Button>
                <Button x:Name="WorkspaceButton" Click="OnWorkspace" AutomationProperties.Name="Classic or Pro workspace" ToolTipService.ToolTip="Classic" Style="{StaticResource IconButtonStyle}">
                    <local:DrawnIcon Kind="workspace" />
                </Button>
                <Button x:Name="ThemeButton" Click="OnTheme" AutomationProperties.Name="Dark or light theme" ToolTipService.ToolTip="Dark" Style="{StaticResource IconButtonStyle}">
                    <local:DrawnIcon Kind="moon" />
                </Button>
                <Button x:Name="ShilpiChip" Content="ShilpiDB" MinHeight="{StaticResource ControlHeight}" Padding="8,0" Click="OnShilpiChip" Visibility="Collapsed" AutomationProperties.Name="ShilpiDB connection" ToolTipService.ToolTip="Connect to a local shilpid server" />
                <TextBlock x:Name="ControlPort" VerticalAlignment="Center" AutomationProperties.Name="Control channel" />
                <TextBlock x:Name="Status" VerticalAlignment="Center" AutomationProperties.Name="Drawing status" />
            </StackPanel>
        </Grid>
        </Border>
        <!-- In-window splash (avoids a second top-level window fighting the command chrome). -->
        <Grid x:Name="SplashOverlay" Grid.RowSpan="8" Background="{ThemeResource SplashBackgroundBrush}" Canvas.ZIndex="1000" AutomationProperties.Name="Splash">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource SpaceMd}">
                <Image x:Name="SplashLogo" Width="96" Height="96" HorizontalAlignment="Center" AutomationProperties.Name="O-Draft" />
                <TextBlock Text="O-Draft" FontSize="{StaticResource FontSizeSplashTitle}" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="Drafting. Part of OSAS, the Open Source Architecture Suite." FontSize="{StaticResource FontSizeSection}" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="Open source · MIT OR Apache-2.0" FontSize="{StaticResource FontSizeBody}" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
