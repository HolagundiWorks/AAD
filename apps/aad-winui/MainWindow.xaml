<Window
    x:Class="Aad.WinUi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AAD">
    <Grid Loaded="OnLoaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <MenuBar x:Name="Bar" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PropertiesColumn" Width="220" MinWidth="0" />
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition x:Name="RightSplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="BlocksColumn" Width="260" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <ScrollViewer>
                <StackPanel x:Name="PropertiesPanel" Margin="8" Spacing="4" />
            </ScrollViewer>
            <Border x:Name="LeftSplitter" Grid.Column="1" Width="6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" PointerPressed="OnSplitPressed" PointerMoved="OnSplitMoved" PointerReleased="OnSplitReleased" />
            <Border x:Name="CanvasHost" Grid.Column="2" Background="Black" SizeChanged="OnCanvasSize" />
            <Border x:Name="RightSplitter" Grid.Column="3" Width="6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" PointerPressed="OnSplitPressed" PointerMoved="OnSplitMoved" PointerReleased="OnSplitReleased" />
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer>
                    <StackPanel x:Name="LayersPanel" Margin="8" Spacing="4" />
                </ScrollViewer>
                <ScrollViewer Grid.Row="1">
                    <StackPanel x:Name="BlocksPanel" Margin="8" Spacing="4" />
                </ScrollViewer>
            </Grid>
        </Grid>
        <ScrollViewer x:Name="HistoryScroll" Grid.Row="2" MaxHeight="120" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="History" Margin="8,4,8,0" FontFamily="Consolas" TextWrapping="Wrap" />
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="8,4,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommandInput" PreviewKeyDown="OnCommandKey" TextChanged="OnDraft" />
            <Button x:Name="PdfButton" Grid.Column="1" Margin="8,0,0,0" Content="PDF" Click="OnPdf" />
            <Button x:Name="WorkspaceButton" Grid.Column="2" Margin="8,0,0,0" Content="Classic" Click="OnWorkspace" />
            <Button x:Name="ThemeButton" Grid.Column="3" Margin="8,0,0,0" Content="Dark" Click="OnTheme" />
            <TextBlock x:Name="Status" Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
