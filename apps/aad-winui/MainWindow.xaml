<Window
    x:Class="Aad.WinUi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AAD">
    <Grid Loaded="OnLoaded" PreviewKeyDown="OnShellKey" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ToolRow" Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <MenuBar x:Name="Bar" />
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="6,3,6,0">
            <StackPanel x:Name="FileTabs" Orientation="Horizontal" Spacing="2" />
        </ScrollViewer>
        <ScrollViewer x:Name="ToolStripHost" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="6,3,6,0">
            <StackPanel x:Name="ToolStrip" Orientation="Horizontal" Spacing="3" />
        </ScrollViewer>
        <Grid x:Name="ContextBar" Grid.Row="3" Margin="6,3,6,0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Layer" VerticalAlignment="Center" />
            <ComboBox x:Name="LayerBox" Grid.Column="1" SelectionChanged="OnLayerPicked" AutomationProperties.Name="Current layer" />
            <TextBlock Grid.Column="2" Text="Floor" VerticalAlignment="Center" />
            <ComboBox x:Name="FloorBox" Grid.Column="3" SelectionChanged="OnFloorPicked" AutomationProperties.Name="Current floor" />
            <TextBlock Grid.Column="4" Text="Space" VerticalAlignment="Center" />
            <ComboBox x:Name="SpaceBox" Grid.Column="5" SelectionChanged="OnSpacePicked" AutomationProperties.Name="Drawing space" />
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PropertiesColumn" Width="165" MinWidth="0" />
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition x:Name="RightSplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="BlocksColumn" Width="195" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <ScrollViewer>
                <StackPanel x:Name="PropertiesPanel" Margin="6" Spacing="3" />
            </ScrollViewer>
            <Border x:Name="LeftSplitter" Grid.Column="1" Width="4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" PointerPressed="OnSplitPressed" PointerMoved="OnSplitMoved" PointerReleased="OnSplitReleased" />
            <Border x:Name="CanvasHost" Grid.Column="2" Background="Black" SizeChanged="OnCanvasSize" />
            <Border x:Name="RightSplitter" Grid.Column="3" Width="4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" PointerPressed="OnSplitPressed" PointerMoved="OnSplitMoved" PointerReleased="OnSplitReleased" />
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer>
                    <StackPanel x:Name="LayersPanel" Margin="6" Spacing="3" />
                </ScrollViewer>
                <ScrollViewer Grid.Row="1">
                    <StackPanel x:Name="BlocksPanel" Margin="6" Spacing="3" />
                </ScrollViewer>
            </Grid>
        </Grid>
        <ScrollViewer x:Name="HistoryScroll" Grid.Row="5" MaxHeight="72" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="History" Margin="6,3,6,0" FontFamily="Consolas" TextWrapping="Wrap" />
        </ScrollViewer>
        <Grid Grid.Row="6" Margin="6,3,6,3" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MaxWidth="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PromptLabel" Text="Command:" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBox x:Name="CommandInput" Grid.Column="1" PreviewKeyDown="OnCommandKey" TextChanged="OnDraft" AutomationProperties.Name="Command line" />
        </Grid>
        <Grid Grid.Row="7" Margin="6,0,6,6" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="+" Click="OnNewLayout" AutomationProperties.Name="New layout" MinWidth="24" />
                    <StackPanel x:Name="LayoutTabs" Orientation="Horizontal" Spacing="2" />
                    <TextBlock x:Name="Coords" VerticalAlignment="Center" Margin="9,0,0,0" FontFamily="Consolas" AutomationProperties.Name="Cursor coordinates" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="SnapButton" Content="Snap" Tag="osnap" Click="OnMode" AutomationProperties.Name="Object snap (F3)" MinWidth="21" />
                <ToggleButton x:Name="OrthoButton" Content="Ortho" Tag="ortho" Click="OnMode" AutomationProperties.Name="Ortho mode (F8)" MinWidth="21" />
                <ToggleButton x:Name="PolarButton" Content="Polar" Tag="polar" Click="OnMode" AutomationProperties.Name="Polar tracking (F10)" MinWidth="21" />
                <ToggleButton x:Name="TrackButton" Content="Track" Tag="otrack" Click="OnMode" AutomationProperties.Name="Object snap tracking (F11)" MinWidth="21" />
                <ToggleButton x:Name="DynButton" Content="Dyn" Tag="dynmode" Click="OnMode" AutomationProperties.Name="Dynamic input (F12)" MinWidth="21" />
                <ToggleButton x:Name="WeightButton" Content="Weight" Tag="lwdisplay" Click="OnMode" AutomationProperties.Name="Show lineweight" MinWidth="21" />
                <ToggleButton x:Name="TransparencyButton" Content="Trans" Tag="transparencydisplay" Click="OnMode" AutomationProperties.Name="Show transparency" MinWidth="21" />
                <ToggleButton x:Name="QuickButton" Content="Props" Tag="qpmode" Click="OnMode" AutomationProperties.Name="Quick properties" MinWidth="21" />
                <Button x:Name="UnitsButton" Content="Units" Click="OnUnits" AutomationProperties.Name="Drawing units and plot" />
                <Button x:Name="LayersButton" Content="Layers" Click="OnLayers" AutomationProperties.Name="Open layer manager" />
                <Button x:Name="PdfButton" Content="PDF" Click="OnPdf" />
                <Button x:Name="WorkspaceButton" Content="Classic" Click="OnWorkspace" />
                <Button x:Name="ThemeButton" Content="Dark" Click="OnTheme" />
                <TextBlock x:Name="Status" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
