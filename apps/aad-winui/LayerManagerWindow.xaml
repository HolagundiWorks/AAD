<Window
    x:Class="Aad.WinUi.LayerManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aad.WinUi"
    Title="Layer Properties Manager">
    <Grid x:Name="Root" PreviewKeyDown="OnWindowKey" Background="{ThemeResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="{StaticResource PaddingMd}" Background="{ThemeResource SurfaceSecondaryBrush}" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}" VerticalAlignment="Center">
                <Button x:Name="MergeButton" Click="OnMergeRequested" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Merge into the side panel" ToolTipService.ToolTip="Merge into the side panel">
                    <local:DrawnIcon x:Name="MergeIcon" Kind="dock" />
                </Button>
                <Button Click="OnNew" AutomationProperties.Name="New layer" ToolTipService.ToolTip="New layer" Style="{StaticResource IconButtonStyle}">
                    <local:DrawnIcon Kind="layer-new" />
                </Button>
                <Button Click="OnDelete" AutomationProperties.Name="Delete selected layers" ToolTipService.ToolTip="Delete layer" Style="{StaticResource IconButtonStyle}">
                    <local:DrawnIcon Kind="delete" />
                </Button>
                <Button Click="OnSetCurrent" AutomationProperties.Name="Make the selected layer current" ToolTipService.ToolTip="Set current" Style="{StaticResource IconButtonStyle}">
                    <local:DrawnIcon Kind="check" />
                </Button>
                <Border Width="1" Margin="6,2" Background="{ThemeResource BorderSubtleBrush}" />
                <TextBlock Text="Layer state" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedCaptionStyle}" />
                <ComboBox x:Name="States" Width="160" MinHeight="{StaticResource ControlHeight}" PlaceholderText="Unsaved layer state" AutomationProperties.Name="Layer state" SelectionChanged="OnStatePicked" />
                <Button x:Name="RestoreStateButton" Content="Restore" MinHeight="{StaticResource ControlHeight}" Margin="6,0,0,0" Click="OnRestoreState" AutomationProperties.Name="Restore layer state" />
                <Button x:Name="DeleteStateButton" Content="Delete" MinHeight="{StaticResource ControlHeight}" Margin="4,0,0,0" Click="OnDeleteState" AutomationProperties.Name="Delete layer state" />
                <TextBox x:Name="StateName" Width="120" MinHeight="{StaticResource ControlHeight}" Margin="8,0,0,0" PlaceholderText="New state name" AutomationProperties.Name="New layer state name" />
                <Button Content="Save state" MinHeight="{StaticResource ControlHeight}" Margin="4,0,0,0" Click="OnSaveState" AutomationProperties.Name="Save layer state" />
                <TextBox
                    x:Name="SearchBox"
                    Width="180"
                    MinHeight="{StaticResource ControlHeight}"
                    Margin="8,0,0,0"
                    PlaceholderText="Search for layer"
                    AutomationProperties.Name="Search for layer"
                    TextChanged="OnSearch" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="{StaticResource PaddingPanelTight}" Spacing="{StaticResource SpaceSm}">
                <TextBlock x:Name="FiltersHeading" Text="Filters" Style="{StaticResource MutedCaptionStyle}" />
                <ListView x:Name="Filters" SelectionMode="Single" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Layer filters">
                    <ListViewItem Content="All" />
                    <ListViewItem>
                        <TextBlock Text="All Used Layers" Margin="14,0,0,0" />
                    </ListViewItem>
                </ListView>
            </StackPanel>
            <Border Grid.Column="1" Width="1" Background="{ThemeResource BorderSubtleBrush}" />
            <ScrollViewer Grid.Column="2" x:Name="TableScroll" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto" Padding="0,4,8,4">
                <StackPanel>
                    <Grid x:Name="Header" MinHeight="{StaticResource ControlHeight}" />
                    <StackPanel x:Name="Rows" />
                </StackPanel>
            </ScrollViewer>
            <TextBlock
                x:Name="Empty"
                Grid.Column="2"
                Text="No layers match the search and filters."
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                IsHitTestVisible="False" />
        </Grid>
        <Grid Grid.Row="2" Padding="10,6" ColumnSpacing="{StaticResource SpaceLg}" Background="{ThemeResource SurfaceSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Summary" VerticalAlignment="Center" AutomationProperties.Name="Layer summary" />
            <TextBlock x:Name="Status" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" AutomationProperties.Name="Layer manager status" />
        </Grid>
    </Grid>
</Window>
