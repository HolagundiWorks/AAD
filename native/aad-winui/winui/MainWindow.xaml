<?xml version="1.0" encoding="utf-8"?>
<!-- Sketch / paste target for Blank App (WinUI 3 C++). Not built by CMake. -->
<Window
    x:Class="Aad.Winui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AAD"
    MinWidth="960"
    MinHeight="640">

  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="32"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="112"/>
      <RowDefinition Height="22"/>
    </Grid.RowDefinitions>

    <!-- Top strip: brand + quiet QAT (Chrome 2.0 — one strip, no ribbon) -->
    <Grid Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Rectangle Grid.Column="0" Fill="#E85D04"/>
      <TextBlock Grid.Column="1" Text="AAD" Margin="12,0,0,0"
                 VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <!-- File / Edit / Plot icons — host only; no geometry ownership -->
      </StackPanel>
    </Grid>

    <!-- Paper: SwapChainPanel hosts Direct2D (or Composition interop) -->
    <SwapChainPanel x:Name="CanvasHost" Grid.Row="1"/>

    <!-- CLI hero -->
    <Grid Grid.Row="2" Padding="8,4,8,4">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ListView x:Name="CliHistory" Grid.Row="0" IsItemClickEnabled="False"
                SelectionMode="None" FontFamily="Consolas" FontSize="12"/>
      <TextBox x:Name="CommandLine" Grid.Row="1" PlaceholderText="Command — Enter runs"
               FontFamily="Consolas" KeyDown="CommandLine_KeyDown"/>
    </Grid>

    <TextBlock x:Name="StatusBar" Grid.Row="3" Margin="8,0,8,0"
               VerticalAlignment="Center" FontSize="11"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               Text="ents 0  rev 0"/>
  </Grid>
</Window>
