<!--
  HCW-UI-Kit token mirror for WinUI — opaque pure neumorphism.
  NEU_RAISED: fill #ECEEF2 · dual shadow 6/6 (no border, no ThemeShadow/blur).
  Heights: ribbon 56 · footer/dock tray 60 · dock hit 44 · taskbar hit 35.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="HcwFogColor">#F2F4F7</Color>
    <Color x:Key="HcwSoftColor">#ECEEF2</Color>
    <Color x:Key="HcwWhiteColor">#FFFFFF</Color>
    <Color x:Key="HcwInkColor">#141517</Color>
    <Color x:Key="HcwAccentColor">#FF4F18</Color>
    <Color x:Key="HcwEdgeColor">#D0D4DC</Color>
    <Color x:Key="HcwMutedColor">#5C6370</Color>
    <Color x:Key="HcwDangerColor">#C8442E</Color>
    <Color x:Key="HcwNeuDarkColor">#29141517</Color>
    <Color x:Key="HcwNeuLightColor">#EBFFFFFF</Color>

    <SolidColorBrush x:Key="HcwFogBrush" Color="{StaticResource HcwFogColor}"/>
    <SolidColorBrush x:Key="HcwSoftBrush" Color="{StaticResource HcwSoftColor}"/>
    <SolidColorBrush x:Key="HcwWhiteBrush" Color="{StaticResource HcwWhiteColor}"/>
    <SolidColorBrush x:Key="HcwInkBrush" Color="{StaticResource HcwInkColor}"/>
    <SolidColorBrush x:Key="HcwAccentBrush" Color="{StaticResource HcwAccentColor}"/>
    <SolidColorBrush x:Key="HcwEdgeBrush" Color="{StaticResource HcwEdgeColor}"/>
    <SolidColorBrush x:Key="HcwMutedBrush" Color="{StaticResource HcwMutedColor}"/>
    <SolidColorBrush x:Key="HcwDangerBrush" Color="{StaticResource HcwDangerColor}"/>
    <SolidColorBrush x:Key="HcwOnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HcwNeuDarkBrush" Color="{StaticResource HcwNeuDarkColor}"/>
    <SolidColorBrush x:Key="HcwNeuLightBrush" Color="{StaticResource HcwNeuLightColor}"/>

    <x:Double x:Key="HcwRibbonHeight">56</x:Double>
    <x:Double x:Key="HcwFooterHeight">60</x:Double>
    <x:Double x:Key="HcwDockTrayHeight">60</x:Double>
    <x:Double x:Key="HcwInset">16</x:Double>
    <x:Double x:Key="HcwDockBottom">92</x:Double>
    <!-- Visual clock face = 100 × 0.8 (Viewbox on dial) -->
    <x:Double x:Key="HcwClockSize">80</x:Double>
    <x:Double x:Key="HcwHitDock">44</x:Double>
    <x:Double x:Key="HcwHitTaskbar">35</x:Double>
    <!-- AADT CAD exception: all chrome is square (radius 0). Suite managers keep 8. -->
    <x:Double x:Key="HcwRadius">0</x:Double>
    <CornerRadius x:Key="HcwCorner8">0</CornerRadius>
    <CornerRadius x:Key="HcwCorner0">0</CornerRadius>

    <FontFamily x:Key="HcwFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="HcwIconFont">Segoe Fluent Icons</FontFamily>

    <!-- Flat stage card — Layer 1 (information at rest). Light edge only. -->
    <Style x:Key="HcwFlatCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HcwWhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HcwEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource HcwCorner8}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- Stage ListView — full-bleed rows (staff geography, not portal 1200 column) -->
    <Style x:Key="HcwStageList" TargetType="ListView">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="IsItemClickEnabled" Value="False"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="MinHeight" Value="44"/>
                    <Setter Property="Margin" Value="0,0,0,2"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Taskbar / Focus tab peer — underline active (web navSx), not orange fill -->
    <Style x:Key="HcwGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource HcwMutedBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="CornerRadius" Value="{StaticResource HcwCorner8}"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="MinHeight" Value="35"/>
        <Setter Property="MaxHeight" Value="35"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontFamily" Value="{StaticResource HcwFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Soft raised chrome tray (NEU_RAISED peer — dual offset, no ThemeShadow) -->
    <Style x:Key="HcwSoftBrief" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HcwSoftBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource HcwCorner8}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- ActionDock pill (kit actionDockButtonSx) — flat transparent · 44 hit · accent on primary -->
    <Style x:Key="HcwDockButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource HcwInkBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource HcwCorner8}"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="MaxHeight" Value="44"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontFamily" Value="{StaticResource HcwFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HcwDockPrimary" TargetType="Button" BasedOn="{StaticResource HcwDockButton}">
        <Setter Property="Foreground" Value="{StaticResource HcwAccentBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="HcwDockDanger" TargetType="Button" BasedOn="{StaticResource HcwDockButton}">
        <Setter Property="Foreground" Value="{StaticResource HcwDangerBrush}"/>
    </Style>

    <!-- Vertical groove between dock zones (NEU_GROOVE_VERTICAL peer) -->
    <Style x:Key="HcwDockGroove" TargetType="Border">
        <Setter Property="Width" Value="2"/>
        <Setter Property="Margin" Value="4,8"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#26141517" Offset="0"/>
                    <GradientStop Color="#D0FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary / commit — Radiant Orange scarce; 44 dock / override to 35 on ribbon -->
    <Style x:Key="HcwPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource HcwAccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource HcwOnAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource HcwCorner8}"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="MaxHeight" Value="44"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontFamily" Value="{StaticResource HcwFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Ribbon compact — 35px -->
    <Style x:Key="HcwRibbonButton" TargetType="Button" BasedOn="{StaticResource HcwGhostButton}">
        <Setter Property="Background" Value="{StaticResource HcwSoftBrush}"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <!-- Wellness panel chips — web WellnessPanel pattern/tab hits (36px) -->
    <Style x:Key="HcwWellnessChip" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource HcwInkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HcwEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource HcwCorner8}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MaxHeight" Value="36"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontFamily" Value="{StaticResource HcwFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HcwWellnessChipActive" TargetType="Button" BasedOn="{StaticResource HcwWellnessChip}">
        <Setter Property="Background" Value="{StaticResource HcwAccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource HcwOnAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Inset neu search field face -->
    <Style x:Key="HcwNeuInput" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource HcwSoftBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource HcwCorner8}"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="MinHeight" Value="35"/>
        <Setter Property="MaxHeight" Value="35"/>
        <Setter Property="Padding" Value="32,0,12,0"/>
        <Setter Property="FontFamily" Value="{StaticResource HcwFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="HcwTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HcwFontFamily}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource HcwInkBrush}"/>
    </Style>

    <Style x:Key="HcwBodyMuted" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HcwFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource HcwInkBrush}"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="HcwLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HcwFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource HcwInkBrush}"/>
        <Setter Property="Opacity" Value="0.7"/>
    </Style>
</ResourceDictionary>
