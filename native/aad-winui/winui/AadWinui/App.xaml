<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AadWinui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AadWinui">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
      </ResourceDictionary.MergedDictionaries>
      <Color x:Key="AadBrandOrange">#E85D04</Color>
      <SolidColorBrush x:Key="AadBrandBrush" Color="{StaticResource AadBrandOrange}"/>
      <Style x:Key="AadQuietButton" TargetType="Button">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
      </Style>
      <Style x:Key="AadRailButton" TargetType="Button">
        <Setter Property="Padding" Value="2,8"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
