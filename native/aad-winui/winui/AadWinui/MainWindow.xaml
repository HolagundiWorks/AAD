<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AadWinui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AadWinui"
    Title="AADT">

    <!--
    AutoCAD 2022 light-theme geography (paper-first) + HCW tokens:
    Title 32 · Menu 28 · Drafting 32 · Paper · floating CLI · status (Model · lyr · Panels · aids)
    Managers = overlays from Panels / View — no side tab rails
    Canon: docs/WINUI-SHELL.md · docs/ux/autocad-research.md
  -->
  <Grid Background="{StaticResource HcwFogBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyDown="Window_KeyDown"
        CharacterReceived="Window_CharacterReceived">
    <Grid.RowDefinitions>
      <RowDefinition Height="32"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="32"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- App bar — OS caption / drag (solid white + ink — avoids washed white-on-white) -->
    <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Padding="10,0,140,0"
          Background="{StaticResource HcwWhiteBrush}"
          BorderBrush="{StaticResource HcwEdgeBrush}" BorderThickness="0,0,0,1"
          AutomationProperties.Name="App title bar">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                  IsHitTestVisible="False">
        <Border Width="14" Height="14" CornerRadius="0"
                Background="{StaticResource HcwAccentBrush}">
          <TextBlock Text="A" FontSize="9" FontWeight="Bold"
                     Foreground="{StaticResource HcwOnAccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="AADT" FontSize="12" FontWeight="SemiBold"
                   FontFamily="{StaticResource HcwFontFamily}"
                   Foreground="{StaticResource HcwInkBrush}" VerticalAlignment="Center"/>
        <TextBlock Text="·" Foreground="{StaticResource HcwMutedBrush}" VerticalAlignment="Center"/>
        <TextBlock x:Name="TitleBarText" Text="Untitled drawing" FontSize="12"
                   FontFamily="{StaticResource HcwFontFamily}"
                   Foreground="{StaticResource HcwMutedBrush}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="520"/>
      </StackPanel>
    </Grid>

    <!-- Menu — flush thin (AutoCAD application menu peer) -->
    <Border Grid.Row="1" Height="28" Padding="8,0"
            Background="{StaticResource HcwWhiteBrush}"
            BorderBrush="{StaticResource HcwEdgeBrush}" BorderThickness="0,0,0,1"
            AutomationProperties.Name="Menu bar">
      <MenuBar Height="24" VerticalAlignment="Center" Background="Transparent"
               Foreground="{StaticResource HcwInkBrush}">
        <MenuBarItem Title="File" AccessKey="F">
          <MenuFlyoutItem Text="New" Click="QatNew_Click" AccessKey="N"/>
          <MenuFlyoutItem Text="Open…" Click="QatOpen_Click" AccessKey="O"/>
          <MenuFlyoutSeparator/>
          <MenuFlyoutItem Text="Save" Click="QatSave_Click" AccessKey="S"/>
          <MenuFlyoutItem Text="Drawing properties…" Click="DrawingProps_Click"/>
          <MenuFlyoutSeparator/>
          <MenuFlyoutItem Text="Plot to PDF…" Click="PlotPdf_Click" AccessKey="P"/>
          <MenuFlyoutItem Text="Plot manager" Click="RightPlotBtn_Click"/>
          <MenuFlyoutSeparator/>
          <MenuFlyoutItem Text="Exit" Click="MenuExit_Click" AccessKey="X"/>
        </MenuBarItem>
        <MenuBarItem Title="Edit" AccessKey="E">
          <MenuFlyoutItem Text="Undo" Click="QatUndo_Click" AccessKey="Z"
                          ToolTipService.ToolTip="Ctrl+Z"/>
          <MenuFlyoutItem Text="Redo" Click="QatRedo_Click" AccessKey="Y"
                          ToolTipService.ToolTip="Ctrl+Y"/>
          <MenuFlyoutSeparator/>
          <MenuFlyoutItem Text="Erase" Click="ToolBtn_Click" Tag="ERASE" AccessKey="E"
                          ToolTipService.ToolTip="Delete selection or pick objects"/>
          <MenuFlyoutSeparator/>
          <MenuFlyoutItem Text="Review / LIST" Click="QatReview_Click"/>
          <MenuFlyoutItem Text="Plot setup" Click="QatPlot_Click"/>
        </MenuBarItem>
        <MenuBarItem Title="Draw" AccessKey="D">
          <MenuFlyoutItem Text="Circle" Click="ToolBtn_Click" Tag="CIRCLE" AccessKey="C"/>
          <MenuFlyoutItem Text="Line" Click="ToolBtn_Click" Tag="LINE" AccessKey="L"/>
          <MenuFlyoutItem Text="Polyline" Click="ToolBtn_Click" Tag="PL"/>
          <MenuFlyoutItem Text="Rectangle" Click="ToolBtn_Click" Tag="REC"/>
          <MenuFlyoutItem Text="Arc" Click="ToolBtn_Click" Tag="ARC"/>
        </MenuBarItem>
        <MenuBarItem Title="Modify" AccessKey="M">
          <MenuFlyoutItem Text="Fillet" Click="ToolBtn_Click" Tag="FILLET" AccessKey="F"
                          ToolTipService.ToolTip="Type radius, then pick two lines"/>
          <MenuFlyoutSeparator/>
          <MenuFlyoutItem Text="Array rectangular" Click="ToolBtn_Click" Tag="ARRAYRECT"
                          ToolTipService.ToolTip="Select objects · type rows/cols · pick spacing"/>
          <MenuFlyoutItem Text="Array polar" Click="ToolBtn_Click" Tag="ARRAYPOLAR"
                          ToolTipService.ToolTip="Select objects · type count · pick center"/>
          <MenuFlyoutItem Text="Array path" Click="ToolBtn_Click" Tag="ARRAYPATH"
                          ToolTipService.ToolTip="Select objects · type count · pick path"/>
          <MenuFlyoutSeparator/>
          <MenuFlyoutItem Text="Move" Click="ToolBtn_Click" Tag="MOVE"/>
          <MenuFlyoutItem Text="Copy" Click="ToolBtn_Click" Tag="COPY"/>
          <MenuFlyoutItem Text="Rotate" Click="ToolBtn_Click" Tag="ROTATE"/>
          <MenuFlyoutItem Text="Scale" Click="ToolBtn_Click" Tag="SCALE"/>
          <MenuFlyoutItem Text="Trim" Click="ToolBtn_Click" Tag="TRIM"/>
          <MenuFlyoutItem Text="Extend" Click="ToolBtn_Click" Tag="EXTEND"/>
        </MenuBarItem>
        <MenuBarItem Title="View" AccessKey="V">
          <MenuFlyoutItem Text="Zoom extents" Click="ZoomExtents_Click" AccessKey="E"
                          ToolTipService.ToolTip="Fit all geometry in the paper (ZE)"/>
          <MenuFlyoutItem Text="Zoom window" Click="ZoomWindow_Click" AccessKey="W"
                          ToolTipService.ToolTip="Drag a window to zoom"/>
          <MenuFlyoutItem Text="Zoom in" Click="ZoomIn_Click"/>
          <MenuFlyoutItem Text="Zoom out" Click="ZoomOut_Click"/>
          <ToggleMenuFlyoutItem x:Name="ViewLockMenuItem" Text="Lock view"
                                IsChecked="True" Click="ViewLock_Click"
                                ToolTipService.ToolTip="Keep pan/zoom across REGEN and draws"/>
          <MenuFlyoutSeparator/>
          <MenuFlyoutItem Text="Layers" Click="LeftLayersBtn_Click"/>
          <MenuFlyoutItem Text="Elements" Click="LeftElementsBtn_Click"/>
          <MenuFlyoutItem Text="Levels" Click="LeftLevelsBtn_Click"/>
          <MenuFlyoutItem Text="History Manager" Click="RightHistoryBtn_Click"/>
          <MenuFlyoutItem Text="Properties" Click="RightPropsBtn_Click"/>
          <MenuFlyoutItem Text="Plot manager" Click="RightPlotBtn_Click"/>
          <MenuFlyoutItem Text="LISP manager" Click="RightLispBtn_Click"/>
          <MenuFlyoutItem Text="Tools catalog…" Click="ToolsPalette_Click"/>
          <MenuFlyoutSeparator/>
          <ToggleMenuFlyoutItem x:Name="ComfortHitsItem" Text="Comfortable hits"
                                Click="ComfortHits_Click"
                                ToolTipService.ToolTip="35px status targets (HCW taskbar peer; default is CAD 24)"/>
        </MenuBarItem>
        <MenuBarItem Title="Automate" AccessKey="A">
          <MenuFlyoutItem Text="LISP manager" Click="RightLispBtn_Click"/>
          <MenuFlyoutItem Text="Load LISP…" Click="LispLoad_Click"/>
          <MenuFlyoutItem Text="Run selection / expression" Click="LispRun_Click"/>
        </MenuBarItem>
        <MenuBarItem Title="Help" AccessKey="H">
          <MenuFlyoutItem Text="About AADT…" Click="MenuAbout_Click"/>
        </MenuBarItem>
      </MenuBar>
    </Border>

    <TextBlock x:Name="RibbonPathLabel" Text="Untitled drawing" Visibility="Collapsed"/>

    <!-- Drafting bar — floor · element · trace · Connect sync · firm · drawing props -->
    <Border Grid.Row="2" Height="32" Padding="8,0"
            Background="{StaticResource HcwWhiteBrush}"
            BorderBrush="{StaticResource HcwEdgeBrush}" BorderThickness="0,0,0,1"
            AutomationProperties.Name="Drafting bar">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
          <Border x:Name="FirmLogoFallback" Width="20" Height="20" CornerRadius="0"
                  Background="{StaticResource HcwAccentBrush}" VerticalAlignment="Center"
                  ToolTipService.ToolTip="Firm from AORMS Connect / drawing properties">
            <TextBlock Text="A" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource HcwOnAccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Image x:Name="FirmLogoImage" Width="20" Height="20" Visibility="Collapsed"
                 Stretch="Uniform" VerticalAlignment="Center"/>
          <TextBlock x:Name="FirmNameLabel" Text="AORMS" FontSize="11" FontWeight="SemiBold"
                     FontFamily="{StaticResource HcwFontFamily}"
                     Foreground="{StaticResource HcwInkBrush}" VerticalAlignment="Center"
                     MaxWidth="140" TextTrimming="CharacterEllipsis"
                     AutomationProperties.Name="Firm name"/>
          <Rectangle Width="1" Height="16" Margin="4,0" Fill="{StaticResource HcwEdgeBrush}"/>
          <TextBlock Text="flr" FontSize="10" VerticalAlignment="Center"
                     Foreground="{StaticResource HcwMutedBrush}"/>
          <ComboBox x:Name="FloorCombo" MinWidth="88" MaxWidth="130" Height="24"
                    FontSize="11" FontFamily="Consolas" Padding="6,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Active floor"
                    ToolTipService.ToolTip="Active floor / level"
                    SelectionChanged="FloorCombo_SelectionChanged"/>
          <TextBlock Text="elem" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                     Foreground="{StaticResource HcwMutedBrush}"/>
          <ComboBox x:Name="ElementCombo" MinWidth="88" MaxWidth="120" Height="24"
                    FontSize="11" FontFamily="Consolas" Padding="6,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Active element category"
                    ToolTipService.ToolTip="Element category → layer shim (A-WALL, S-COLS, …)"
                    SelectionChanged="ElementCombo_SelectionChanged"/>
          <TextBlock Text="trc" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                     Foreground="{StaticResource HcwMutedBrush}"/>
          <ComboBox x:Name="TraceCombo" MinWidth="100" MaxWidth="150" Height="24"
                    FontSize="11" FontFamily="Consolas" Padding="6,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Floor trace underlay"
                    ToolTipService.ToolTip="Ghost floors above / below / any selected level"
                    SelectionChanged="TraceCombo_SelectionChanged"/>
        </StackPanel>
        <TextBlock x:Name="DraftBarTitleHint" Grid.Column="1"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="11" Foreground="{StaticResource HcwMutedBrush}"
                   TextTrimming="CharacterEllipsis" MaxWidth="280"
                   Text="Untitled drawing"
                   AutomationProperties.Name="Drawing title"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
          <Button Content="Sync" Style="{StaticResource AadQuietButton}" Height="24"
                  Click="DraftBarSync_Click"
                  AutomationProperties.Name="Sync Connect"
                  ToolTipService.ToolTip="Flush AORMS Connect outbox and refresh firm / licence"/>
          <Button Content="Drawing…" Style="{StaticResource AadQuietButton}" Height="24"
                  Click="DrawingProps_Click"
                  AutomationProperties.Name="Drawing properties"
                  ToolTipService.ToolTip="Title plate, firm, logo, project fields"/>
          <Button Content="Meta" Style="{StaticResource AadQuietButton}" Height="24"
                  Click="DraftBarMeta_Click"
                  AutomationProperties.Name="Meta tagger"
                  ToolTipService.ToolTip="AQC / BBS tags on selection (MARK, WALL_NAME, AQC_CODE, …)"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- STAGE — paper-first (≈85%+) -->
    <Grid Grid.Row="3" Background="{StaticResource HcwFogBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition x:Name="StatusRowDef" Height="28"/>
      </Grid.RowDefinitions>

      <!-- Paper (managers open from status bar / menus — no side tab rails) -->
      <Grid Grid.Row="0">
          <Border Background="{StaticResource HcwWhiteBrush}"
                  AutomationProperties.Name="Drawing paper"
                  AutomationProperties.LandmarkType="Main">
            <SwapChainPanel x:Name="CanvasHost" IsHitTestVisible="True" IsTabStop="True"
                            AutomationProperties.Name="Drawing canvas"/>
          </Border>
          <!-- Viewport chrome peer -->
          <TextBlock Text="[-] [Top] [2D]" Margin="8,6,0,0" FontSize="11"
                     FontFamily="Consolas" Foreground="{StaticResource HcwMutedBrush}"
                     IsHitTestVisible="False"/>
          <Canvas x:Name="DynOverlayCanvas" IsHitTestVisible="False">
            <Border x:Name="DynInputCard" Visibility="Collapsed"
                    Background="{StaticResource HcwWhiteBrush}"
                    BorderBrush="{StaticResource HcwAccentBrush}" BorderThickness="1"
                    CornerRadius="0" Padding="6,4" MinWidth="140" MaxWidth="260"
                    IsHitTestVisible="True">
              <StackPanel Spacing="2">
                <Border Height="2" Background="{StaticResource HcwAccentBrush}"
                        AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock x:Name="DynPromptText" FontSize="11" FontWeight="SemiBold"
                           FontFamily="{StaticResource HcwFontFamily}"
                           Foreground="{StaticResource HcwInkBrush}" TextWrapping="Wrap"
                           Text="Specify first point"
                           AutomationProperties.LiveSetting="Assertive"/>
                <TextBlock x:Name="DynCoordsText" FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource HcwMutedBrush}" Text="0.00, 0.00"
                           AutomationProperties.Name="Cursor coordinates"/>
                <TextBox x:Name="DynInputBox" FontFamily="Consolas" FontSize="12" Height="24"
                         PlaceholderText="dist · x,y · keyword"
                         AutomationProperties.Name="Dynamic input value"
                         KeyDown="DynInput_KeyDown" PreviewKeyDown="DynInput_PreviewKeyDown"
                         CharacterReceived="DynInput_CharacterReceived"/>
              </StackPanel>
            </Border>
          </Canvas>

          <!-- Floating command line — AutoCAD bottom-center peer -->
          <Border x:Name="CliFloat" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                  Margin="0,0,0,8" Width="480" MaxWidth="640" MinWidth="320"
                  Background="{StaticResource HcwWhiteBrush}"
                  BorderBrush="{StaticResource HcwEdgeBrush}" BorderThickness="1"
                  CornerRadius="0" Padding="8,4" Canvas.ZIndex="30">
            <Grid AutomationProperties.Name="Command line panel">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Height="2" Margin="0,0,0,4"
                      Background="{StaticResource HcwAccentBrush}"
                      AutomationProperties.AccessibilityView="Raw"/>
              <ListView x:Name="CliHistory" Grid.Row="1" IsItemClickEnabled="False"
                        SelectionMode="None" FontFamily="Consolas" FontSize="11"
                        AutomationProperties.Name="Command history"
                        AutomationProperties.LiveSetting="Polite"/>
              <ListView x:Name="CompleteList" Grid.Row="2" MaxHeight="36" Margin="0,0,0,2"
                        Visibility="Collapsed" SelectionMode="Single" IsItemClickEnabled="True"
                        FontFamily="Consolas" FontSize="10"
                        AutomationProperties.Name="Command completions"
                        ItemClick="CompleteList_ItemClick"/>
              <TextBlock x:Name="CliPromptText" Grid.Row="3" FontFamily="Consolas" FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource HcwInkBrush}"
                         Text="Type a command" TextTrimming="CharacterEllipsis"
                         AutomationProperties.LiveSetting="Assertive"/>
              <TextBox x:Name="CommandLine" Grid.Row="4" Height="24" BorderThickness="0"
                       PlaceholderText="alias or value — Enter or Space runs"
                       FontFamily="Consolas" FontSize="12"
                       AutomationProperties.Name="Command line"
                       KeyDown="CommandLine_KeyDown"
                       PreviewKeyDown="CommandLine_PreviewKeyDown"
                       CharacterReceived="CommandLine_CharacterReceived"
                       TextChanged="CommandLine_TextChanged"
                       IsTabStop="True" AllowFocusOnInteraction="True"/>
            </Grid>
          </Border>

        <!-- Left overlay pane — open from status bar / View menu -->
        <Border x:Name="LeftPane" Width="340" HorizontalAlignment="Left"
                Background="{StaticResource HcwWhiteBrush}"
                BorderBrush="{StaticResource HcwEdgeBrush}" BorderThickness="0,0,1,0"
                CornerRadius="0"
                Visibility="Collapsed" Padding="8"
                PointerEntered="LeftPane_PointerEntered"
                PointerExited="LeftPane_PointerExited" Canvas.ZIndex="20"
                AutomationProperties.Name="Layer manager">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="LeftTabLayers" Content="Layers" Style="{StaticResource AadPaneTab}"
                      AutomationProperties.Name="Layers tab"
                      Click="LeftTabLayers_Click"/>
              <Button x:Name="LeftTabElements" Content="Elements" Style="{StaticResource AadPaneTab}"
                      AutomationProperties.Name="Elements tab"
                      Click="LeftTabElements_Click"/>
              <Button x:Name="LeftTabLevels" Content="Levels" Style="{StaticResource AadPaneTab}"
                      AutomationProperties.Name="Levels tab"
                      Click="LeftTabLevels_Click"/>
              <Button x:Name="LeftTabFills" Content="Fills" Style="{StaticResource AadPaneTab}"
                      AutomationProperties.Name="Fills tab"
                      Click="LeftTabFills_Click"/>
              <Button x:Name="LeftTabMeta" Content="Meta" Style="{StaticResource AadPaneTab}"
                      AutomationProperties.Name="Meta tagger tab"
                      Click="LeftTabMeta_Click"/>
            </StackPanel>

            <!-- Layer manager — ISO 13567 / AIA CAD Layer Guidelines (HCW catalog) -->
            <StackPanel x:Name="LayerCreateRow" Grid.Row="1" Margin="0,8,0,0" Spacing="4">
              <TextBlock Text="Layer manager" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource HcwInkBrush}"/>
              <TextBlock Text="ISO 13567 / AIA · color · linetype · lineweight (mm) · &gt; = current"
                         FontSize="10" Foreground="{StaticResource HcwMutedBrush}"
                         TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Seed ISO/AIA" Style="{StaticResource AadQuietButton}"
                        Click="LayerStandards_Click"
                        AutomationProperties.Name="Seed international standard layers"
                        ToolTipService.ToolTip="STANDARDS — seed HCW / ISO 13567 / AIA catalog"/>
                <Button Content="Layer set" Style="{StaticResource AadQuietButton}"
                        AutomationProperties.Name="Apply layer visibility set">
                  <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                      <MenuFlyoutItem Text="CONSTRUCTION" Tag="CONSTRUCTION" Click="LayerSetItem_Click"/>
                      <MenuFlyoutItem Text="STRUCTURAL" Tag="STRUCTURAL" Click="LayerSetItem_Click"/>
                      <MenuFlyoutItem Text="CIVIL" Tag="CIVIL" Click="LayerSetItem_Click"/>
                      <MenuFlyoutItem Text="SERVICES" Tag="SERVICES" Click="LayerSetItem_Click"/>
                      <MenuFlyoutItem Text="ELECTRICAL" Tag="ELECTRICAL" Click="LayerSetItem_Click"/>
                      <MenuFlyoutItem Text="PLUMBING" Tag="PLUMBING" Click="LayerSetItem_Click"/>
                      <MenuFlyoutItem Text="FIRE" Tag="FIRE" Click="LayerSetItem_Click"/>
                      <MenuFlyoutItem Text="ELV" Tag="ELV" Click="LayerSetItem_Click"/>
                      <MenuFlyoutItem Text="LANDSCAPE" Tag="LANDSCAPE" Click="LayerSetItem_Click"/>
                      <MenuFlyoutItem Text="PRESENTATION" Tag="PRESENTATION" Click="LayerSetItem_Click"/>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
              <TextBox x:Name="LayerFilterBox" Height="24" FontSize="11"
                       PlaceholderText="Filter layers…"
                       AutomationProperties.Name="Filter layers"
                       TextChanged="LayerFilter_TextChanged"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LayerNewBox" Height="24" FontSize="11"
                         PlaceholderText="New layer (e.g. A-WALL)"
                         AutomationProperties.Name="New layer name"/>
                <Button Grid.Column="1" Content="New" Margin="4,0,0,0"
                        Style="{StaticResource AadQuietButton}"
                        Click="LayerNew_Click"
                        AutomationProperties.Name="Create layer"/>
              </Grid>
              <!-- Selected layer props: ACI · LTYPE · LW -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="LayerColorSwatch" Width="22" Height="22" Margin="0,0,4,0"
                        Background="{StaticResource HcwInkBrush}"
                        BorderBrush="{StaticResource HcwEdgeBrush}" BorderThickness="1"
                        CornerRadius="0"
                        AutomationProperties.Name="Layer color swatch"/>
                <ComboBox x:Name="LayerColorCombo" Grid.Column="1" Height="24" FontSize="11"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Layer ACI color"
                          SelectionChanged="LayerColorCombo_SelectionChanged"/>
                <TextBox x:Name="LayerAciBox" Grid.Column="2" Width="44" Height="24" Margin="4,0,0,0"
                         FontSize="11" PlaceholderText="ACI"
                         AutomationProperties.Name="ACI number"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="LayerLtypeCombo" Height="24" FontSize="11"
                          HorizontalAlignment="Stretch" Margin="0,0,4,0"
                          AutomationProperties.Name="Layer linetype"/>
                <ComboBox x:Name="LayerLwCombo" Grid.Column="1" Height="24" FontSize="11"
                          HorizontalAlignment="Stretch" Margin="0,0,4,0"
                          AutomationProperties.Name="Layer lineweight millimetres"/>
                <Button Grid.Column="2" Content="Apply" Style="{StaticResource AadQuietButton}"
                        Click="LayerApplyProps_Click"
                        AutomationProperties.Name="Apply layer color linetype lineweight"/>
              </Grid>
            </StackPanel>

            <!-- Elements manager header -->
            <StackPanel x:Name="ElementCreateRow" Grid.Row="1" Margin="0,8,0,0" Spacing="4"
                        Visibility="Collapsed">
              <TextBlock Text="Elements manager" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource HcwInkBrush}"/>
              <TextBlock Text="Select a block or catalog element, then Place on the paper"
                         FontSize="10" Foreground="{StaticResource HcwMutedBrush}"
                         TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Levels manager header (ADR-0009 floors) -->
            <StackPanel x:Name="LevelCreateRow" Grid.Row="1" Margin="0,8,0,0" Spacing="4"
                        Visibility="Collapsed">
              <TextBlock Text="Levels manager" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource HcwInkBrush}"/>
              <TextBlock Text="Floor · Space drafting context · * marks active level"
                         FontSize="10" Foreground="{StaticResource HcwMutedBrush}"
                         TextWrapping="Wrap"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LevelNewBox" Height="24" FontSize="11"
                         PlaceholderText="New level name"
                         AutomationProperties.Name="New level name"/>
                <Button Grid.Column="1" Content="Add" Margin="4,0,0,0"
                        Style="{StaticResource AadQuietButton}"
                        Click="LevelNew_Click"
                        AutomationProperties.Name="Add level"/>
              </Grid>
              <TextBlock Text="Category (model space)" FontSize="10" Margin="0,4,0,0"
                         Foreground="{StaticResource HcwMutedBrush}"/>
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Content="Walls" Style="{StaticResource AadQuietButton}" Tag="Walls"
                        Click="CategoryBtn_Click" AutomationProperties.Name="Category Walls"/>
                <Button Content="Struct" Style="{StaticResource AadQuietButton}" Tag="Structural"
                        Click="CategoryBtn_Click" AutomationProperties.Name="Category Structural"/>
                <Button Content="Lintel" Style="{StaticResource AadQuietButton}" Tag="Lintel"
                        Click="CategoryBtn_Click" AutomationProperties.Name="Category Lintel"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Content="Beam" Style="{StaticResource AadQuietButton}" Tag="BeamLayout"
                        Click="CategoryBtn_Click" AutomationProperties.Name="Category BeamLayout"/>
                <Button Content="Furn" Style="{StaticResource AadQuietButton}" Tag="Furniture"
                        Click="CategoryBtn_Click" AutomationProperties.Name="Category Furniture"/>
              </StackPanel>
            </StackPanel>

            <ListView x:Name="LayersList" Grid.Row="2" Margin="0,6,0,6"
                      SelectionMode="Single" IsItemClickEnabled="True"
                      AutomationProperties.Name="Layers list"
                      ItemClick="LayersList_ItemClick"
                      DoubleTapped="LayersList_DoubleTapped"/>
            <ListView x:Name="BlocksList" Grid.Row="2" Margin="0,6,0,6" Visibility="Collapsed"
                      SelectionMode="Single" IsItemClickEnabled="True"
                      AutomationProperties.Name="Elements list"
                      ItemClick="BlocksList_ItemClick"/>
            <ListView x:Name="LevelsList" Grid.Row="2" Margin="0,6,0,6" Visibility="Collapsed"
                      SelectionMode="Single" IsItemClickEnabled="True"
                      AutomationProperties.Name="Levels list"
                      ItemClick="LevelsList_ItemClick"
                      DoubleTapped="LevelsList_DoubleTapped"/>
            <ListView x:Name="FillsList" Grid.Row="2" Margin="0,6,0,6" Visibility="Collapsed"
                      SelectionMode="Single" IsItemClickEnabled="True"
                      ItemClick="FillsList_ItemClick"/>

            <!-- AQC / BBS meta tagger (selection attributes) -->
            <ScrollViewer x:Name="MetaScroll" Grid.Row="1" Grid.RowSpan="3" Margin="0,8,0,0"
                          Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="6" Padding="0,0,0,8">
                <TextBlock Text="Meta tagger" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource HcwInkBrush}"/>
                <TextBlock x:Name="MetaContextLabel"
                           Text="Select objects · tags feed AQC Estimation / BBS"
                           FontSize="10" Foreground="{StaticResource HcwMutedBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="MetaLevelHint" FontSize="10"
                           Foreground="{StaticResource HcwMutedBrush}"
                           Text="Level · Element —"/>
                <TextBox x:Name="MetaMarkBox" Height="24" FontSize="11" PlaceholderText="MARK (MW1, C1)"/>
                <TextBox x:Name="MetaWallNameBox" Height="24" FontSize="11" PlaceholderText="WALL_NAME"/>
                <TextBox x:Name="MetaNosBox" Height="24" FontSize="11" PlaceholderText="NOS (count)"/>
                <TextBox x:Name="MetaAqcCodeBox" Height="24" FontSize="11" PlaceholderText="AQC_CODE / rate code"/>
                <TextBox x:Name="MetaColumnNoBox" Height="24" FontSize="11" PlaceholderText="COLUMN_NO"/>
                <TextBox x:Name="MetaCodeBox" Height="24" FontSize="11" PlaceholderText="CODE"/>
                <TextBox x:Name="MetaTradeBox" Height="24" FontSize="11" PlaceholderText="TRADE (Masonry, Concrete, …)"/>
                <TextBox x:Name="MetaMaterialBox" Height="24" FontSize="11" PlaceholderText="MATERIAL"/>
                <Button Content="Apply to selection" Style="{StaticResource AadQuietButton}"
                        HorizontalAlignment="Stretch" Click="MetaApply_Click"
                        AutomationProperties.Name="Apply meta tags to selection"/>
                <Button Content="Reload from selection" Style="{StaticResource AadQuietButton}"
                        HorizontalAlignment="Stretch" Click="MetaReload_Click"
                        AutomationProperties.Name="Reload meta from selection"/>
              </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="LayerActions" Grid.Row="3" Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Current" Style="{StaticResource AadQuietButton}"
                        Click="LayerCurrent_Click"
                        AutomationProperties.Name="Set current layer"
                        ToolTipService.ToolTip="Set selected as current layer"/>
                <Button Content="On" Style="{StaticResource AadQuietButton}" Click="LayerOn_Click"/>
                <Button Content="Off" Style="{StaticResource AadQuietButton}" Click="LayerOff_Click"/>
                <Button Content="Freeze" Style="{StaticResource AadQuietButton}" Click="LayerFreeze_Click"/>
                <Button Content="Thaw" Style="{StaticResource AadQuietButton}" Click="LayerThaw_Click"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Lock" Style="{StaticResource AadQuietButton}" Click="LayerLock_Click"/>
                <Button Content="Unlock" Style="{StaticResource AadQuietButton}" Click="LayerUnlock_Click"/>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="ElementActions" Grid.Row="3" Visibility="Collapsed" Spacing="4">
              <Button x:Name="BlockPlaceBtn" Content="Place selected" Style="{StaticResource AadQuietButton}"
                      Click="BlockPlace_Click" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Place element"/>
            </StackPanel>
            <StackPanel x:Name="LevelActions" Grid.Row="3" Visibility="Collapsed" Spacing="4">
              <Button Content="Set active" Style="{StaticResource AadQuietButton}"
                      Click="LevelCurrent_Click" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Set active level"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Right overlay -->
        <Border x:Name="RightPane" Width="300" HorizontalAlignment="Right"
                Background="{StaticResource HcwWhiteBrush}"
                BorderBrush="{StaticResource HcwEdgeBrush}" BorderThickness="1,0,0,0"
                CornerRadius="0"
                Visibility="Collapsed" Padding="8"
                PointerEntered="RightPane_PointerEntered"
                PointerExited="RightPane_PointerExited" Canvas.ZIndex="20"
                AutomationProperties.Name="Properties and tools pane">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="RightTabProps" Content="Props" Style="{StaticResource AadPaneTab}"
                      AutomationProperties.Name="Properties tab"
                      Click="RightTabProps_Click"/>
              <Button x:Name="RightTabHistory" Content="Hist" Style="{StaticResource AadPaneTab}"
                      AutomationProperties.Name="History tab"
                      Click="RightTabHistory_Click"/>
              <Button x:Name="RightTabPlot" Content="Plot" Style="{StaticResource AadPaneTab}"
                      AutomationProperties.Name="Plot tab"
                      Click="RightTabPlot_Click"/>
              <Button x:Name="RightTabLisp" Content="LISP" Style="{StaticResource AadPaneTab}"
                      AutomationProperties.Name="LISP tab"
                      Click="RightTabLisp_Click"/>
            </StackPanel>
            <Grid x:Name="PropsPane" Grid.Row="1" Margin="0,6,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <ScrollViewer Margin="0,0,0,6">
                <StackPanel x:Name="PropsBody">
                  <TextBlock x:Name="PropsEmpty"
                             Text="No selection — click an object on the paper."
                             TextWrapping="Wrap"
                             Foreground="{StaticResource HcwMutedBrush}" FontSize="11"/>
                  <ListView x:Name="PropsList" Visibility="Collapsed"
                            SelectionMode="None" IsItemClickEnabled="False"
                            FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                <TextBlock x:Name="PropsLayerLabel" Text="Layer" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource HcwMutedBrush}"/>
                <TextBox x:Name="PropsLayerBox" Width="120" PlaceholderText="layer name"
                         FontFamily="Consolas" FontSize="11" Height="24"
                         AutomationProperties.Name="Selection layer"/>
                <Button Content="Apply" Style="{StaticResource AadQuietButton}" Click="PropsLayerApply_Click"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                <Button Content="CHSPACE" Style="{StaticResource AadQuietButton}" Click="PropsChspace_Click"/>
                <Button Content="Erase" Style="{StaticResource AadQuietButton}" Click="PropsErase_Click"/>
              </StackPanel>
            </Grid>
            <Grid x:Name="HistoryPane" Grid.Row="1" Margin="0,6,0,0" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="File versions (.aadt / .vdb) — select a version to trace changes"
                         FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap"
                         Foreground="{StaticResource HcwMutedBrush}"/>
              <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,6">
                <TextBlock x:Name="HistoryLabelCaption" Text="Commit point label" FontSize="10"
                           Foreground="{StaticResource HcwMutedBrush}" Margin="0,0,0,2"/>
                <TextBox x:Name="HistoryLabelBox" PlaceholderText="Issued for construction" FontSize="11" Height="24"
                         AutomationProperties.Name="Commit point label"/>
                <Button Content="Save commit point" Style="{StaticResource AadQuietButton}"
                        HorizontalAlignment="Stretch" Click="HistorySave_Click"
                        AutomationProperties.Name="Save commit point"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="Refresh" Style="{StaticResource AadQuietButton}" Click="HistoryRefresh_Click"/>
                  <Button Content="Purge autos" Style="{StaticResource AadQuietButton}" Click="HistoryPurge_Click"/>
                </StackPanel>
              </StackPanel>
              <ListView x:Name="HistoryList" Grid.Row="2" SelectionMode="Single"
                        IsItemClickEnabled="False" FontFamily="Consolas" FontSize="10"
                        SelectionChanged="HistoryList_SelectionChanged"/>
              <TextBlock x:Name="HistoryDiffText" Grid.Row="3" Margin="0,6,0,0"
                         FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"
                         Foreground="{StaticResource HcwInkBrush}"
                         Text="Select a version to see +added · ~modified · -removed vs the tip."/>
              <Button Grid.Row="4" Content="Restore selected" Margin="0,6,0,0"
                      Style="{StaticResource AadQuietButton}" HorizontalAlignment="Stretch"
                      Click="HistoryRestore_Click"/>
            </Grid>

            <!-- Plot manager -->
            <StackPanel x:Name="PlotPane" Grid.Row="1" Margin="0,6,0,0" Spacing="6"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Plot manager">
              <TextBlock Text="Plot manager" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource HcwInkBrush}"/>
              <TextBlock Text="Compose sheet from model extents and export PDF"
                         FontSize="10" TextWrapping="Wrap"
                         Foreground="{StaticResource HcwMutedBrush}"/>
              <TextBlock Text="Paper size" FontSize="10"
                         Foreground="{StaticResource HcwMutedBrush}"/>
              <ComboBox x:Name="PlotPaperBox" Height="28" HorizontalAlignment="Stretch"
                        SelectedIndex="1"
                        AutomationProperties.Name="Plot paper size">
                <ComboBoxItem Content="A4"/>
                <ComboBoxItem Content="A3"/>
                <ComboBoxItem Content="A2"/>
                <ComboBoxItem Content="A1"/>
                <ComboBoxItem Content="A0"/>
                <ComboBoxItem Content="ANSI-D"/>
                <ComboBoxItem Content="ARCH-D"/>
              </ComboBox>
              <Button Content="Plot to PDF…" Style="{StaticResource AadQuietButton}"
                      HorizontalAlignment="Stretch" Click="PlotPdf_Click"
                      AutomationProperties.Name="Plot to PDF"/>
              <Button Content="Place sheet border" Style="{StaticResource AadQuietButton}"
                      HorizontalAlignment="Stretch" Click="PlotSetup_Click"
                      ToolTipService.ToolTip="PLOTSETUP — border on BORDER layer"
                      AutomationProperties.Name="Place sheet border"/>
              <TextBlock x:Name="PlotStatusText" Text="" FontSize="10" TextWrapping="Wrap"
                         FontFamily="Consolas"
                         Foreground="{StaticResource HcwMutedBrush}"
                         AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>

            <!-- LISP manager -->
            <Grid x:Name="LispPane" Grid.Row="1" Margin="0,6,0,0" Visibility="Collapsed"
                  AutomationProperties.Name="LISP manager">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Spacing="4">
                <TextBlock Text="LISP manager" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource HcwInkBrush}"/>
                <TextBlock Text="AutoLISP against the live drawing · LISP / LISPLOAD / (…)"
                           FontSize="10" TextWrapping="Wrap"
                           Foreground="{StaticResource HcwMutedBrush}"/>
                <TextBox x:Name="LispExprBox" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="72" FontFamily="Consolas" FontSize="11"
                         PlaceholderText="(+ 1 2)  or  LISP (aadt-ents)"
                         AutomationProperties.Name="LISP expression"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="Run" Style="{StaticResource AadQuietButton}"
                          Click="LispRun_Click" AutomationProperties.Name="Run LISP"/>
                  <Button Content="Load…" Style="{StaticResource AadQuietButton}"
                          Click="LispLoad_Click" AutomationProperties.Name="Load LISP file"/>
                  <Button Content="Clear out" Style="{StaticResource AadQuietButton}"
                          Click="LispClear_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button Content="(+ 1 2)" Style="{StaticResource AadQuietButton}" Tag="(+ 1 2)"
                          Click="LispSample_Click"/>
                  <Button Content="ents" Style="{StaticResource AadQuietButton}" Tag="(aadt-entity-count)"
                          Click="LispSample_Click"/>
                  <Button Content="objects" Style="{StaticResource AadQuietButton}" Tag="(aadt-objects)"
                          Click="LispSample_Click"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Grid.Row="1" Text="Output" FontSize="10" Margin="0,8,0,2"
                         Foreground="{StaticResource HcwMutedBrush}"/>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LispOutputText" FontFamily="Consolas" FontSize="10"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Foreground="{StaticResource HcwInkBrush}"
                           AutomationProperties.Name="LISP output"
                           AutomationProperties.LiveSetting="Polite"/>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Bottom status strip — Model · coords · aids · sync (AutoCAD status bar) -->
      <Grid x:Name="TaskbarChrome" Grid.Row="1" Height="28"
            Background="{StaticResource HcwSoftBrush}"
            BorderBrush="{StaticResource HcwEdgeBrush}" BorderThickness="0,1,0,0"
            AutomationProperties.Name="Status bar">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" Spacing="2">
          <Button x:Name="ModelTabBtn" Content="Model" Style="{StaticResource AadModelTab}"
                  AutomationProperties.Name="Model space"
                  ToolTipService.ToolTip="Model space"/>
          <Border Background="{StaticResource HcwWhiteBrush}" Padding="8,0" Height="22"
                  CornerRadius="0" VerticalAlignment="Center"
                  BorderBrush="{StaticResource HcwEdgeBrush}" BorderThickness="1"
                  AutomationProperties.Name="Current layer"
                  ToolTipService.ToolTip="Current layer — click to open Layers"
                  Tapped="LayerChip_Tapped">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="lyr" FontSize="10" VerticalAlignment="Center"
                         Foreground="{StaticResource HcwMutedBrush}"/>
              <TextBlock x:Name="LayerCurrentLabel" Text="0" FontSize="11"
                         FontFamily="Consolas" VerticalAlignment="Center"
                         Foreground="{StaticResource HcwInkBrush}" MinWidth="40"
                         AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </Border>
          <!-- Hidden legacy label kept for LevelChip_Tapped / status sync -->
          <TextBlock x:Name="LevelCurrentLabel" Visibility="Collapsed"
                     Text="Ground · Walls"/>
          <!-- Capacity: one Panels entry — managers live in flyout / View menu -->
          <Button x:Name="PanelsBtn" Content="Panels" Style="{StaticResource AadQuietButton}"
                  BorderThickness="0,0,0,2" BorderBrush="Transparent"
                  AutomationProperties.Name="Panels"
                  ToolTipService.ToolTip="Open Layers, Properties, Plot, LISP, and other managers">
            <Button.Flyout>
              <MenuFlyout Placement="Top">
                <MenuFlyoutItem Text="Layers" Click="LeftLayersBtn_Click"/>
                <MenuFlyoutItem Text="Elements" Click="LeftElementsBtn_Click"/>
                <MenuFlyoutItem Text="Levels" Click="LeftLevelsBtn_Click"/>
                <MenuFlyoutItem Text="Fills" Click="LeftFillsBtn_Click"/>
                <MenuFlyoutItem Text="Meta tagger" Click="DraftBarMeta_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Properties" Click="RightPropsBtn_Click"/>
                <MenuFlyoutItem Text="Plot manager" Click="RightPlotBtn_Click"/>
                <MenuFlyoutItem Text="LISP manager" Click="RightLispBtn_Click"/>
                <MenuFlyoutItem Text="History" Click="RightHistoryBtn_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Tools catalog…" Click="ToolsPalette_Click"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="ZoomBtn" Content="Zoom" Style="{StaticResource AadQuietButton}"
                  AutomationProperties.Name="Zoom"
                  ToolTipService.ToolTip="Zoom extents · window · in · out">
            <Button.Flyout>
              <MenuFlyout Placement="Top">
                <MenuFlyoutItem Text="Zoom extents" Click="ZoomExtents_Click"
                                ToolTipService.ToolTip="Fit all geometry (ZE)"/>
                <MenuFlyoutItem Text="Zoom window" Click="ZoomWindow_Click"/>
                <MenuFlyoutItem Text="Zoom in" Click="ZoomIn_Click"/>
                <MenuFlyoutItem Text="Zoom out" Click="ZoomOut_Click"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <ToggleButton x:Name="ViewLockBtn" Content="ZL" Style="{StaticResource AadAidChip}"
                        IsChecked="True" Click="ViewLock_Click"
                        AutomationProperties.Name="Lock view"
                        ToolTipService.ToolTip="Lock view — keep pan/zoom when regenerating"/>
        </StackPanel>

        <TextBlock x:Name="StatusBar" Grid.Column="1"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="10" FontFamily="Consolas"
                   Foreground="{StaticResource HcwMutedBrush}"
                   Text="ents 0  rev 0"
                   TextTrimming="CharacterEllipsis"
                   AutomationProperties.Name="Drawing status"
                   AutomationProperties.LiveSetting="Polite"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="0,0,8,0" Spacing="2">
          <TextBlock x:Name="CoordStatus" Text="0.00, 0.00" FontSize="10" FontFamily="Consolas"
                     Foreground="{StaticResource HcwInkBrush}" VerticalAlignment="Center"
                     Margin="0,0,8,0" MinWidth="100"
                     AutomationProperties.Name="Cursor coordinates"
                     AutomationProperties.LiveSetting="Polite"/>
          <ToggleButton x:Name="AidOsnap" Content="OS" Style="{StaticResource AadAidChip}"
                        IsChecked="True" Click="AidOsnap_Click"
                        AutomationProperties.Name="Object snap"
                        ToolTipService.ToolTip="Object snap (F3)"/>
          <ToggleButton x:Name="AidOrtho" Content="OR" Style="{StaticResource AadAidChip}"
                        Click="AidOrtho_Click"
                        AutomationProperties.Name="Ortho mode"
                        ToolTipService.ToolTip="Ortho (F8)"/>
          <ToggleButton x:Name="AidPolar" Content="PO" Style="{StaticResource AadAidChip}"
                        Click="AidPolar_Click"
                        AutomationProperties.Name="Polar tracking"
                        ToolTipService.ToolTip="Polar (F10)"/>
          <ToggleButton x:Name="AidDyn" Content="DY" Style="{StaticResource AadAidChip}"
                        IsChecked="True" Click="AidDyn_Click"
                        AutomationProperties.Name="Dynamic input"
                        ToolTipService.ToolTip="Dynamic Input (F12)"/>
          <ToggleButton x:Name="AidLwt" Content="LWT" Style="{StaticResource AadAidChip}"
                        IsChecked="True" Click="AidLwt_Click"
                        AutomationProperties.Name="Lineweights display"
                        ToolTipService.ToolTip="Show layer lineweights (ISO mm pens)"/>
          <Button x:Name="UnitsChip" Content="ft-in" Style="{StaticResource AadQuietButton}"
                  MinWidth="44" Height="22" Padding="6,0" FontSize="10"
                  Click="UnitsChip_Click"
                  AutomationProperties.Name="Drawing units"
                  ToolTipService.ToolTip="Units &amp; Dimension manager — ft-in / m, precision, fractions">
            <Button.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="Imperial — feet &amp; inches (ft-in)" Click="UnitsImperial_Click"/>
                <MenuFlyoutItem Text="Metric — decimal meters (m)" Click="UnitsMetric_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Dimension manager…" Click="DimManager_Click"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Rectangle Width="1" Height="14" Margin="4,0" Fill="{StaticResource HcwEdgeBrush}"/>
          <Button x:Name="CalcBtn" Style="{StaticResource AadQuietButton}"
                  MinWidth="28" Height="22" Padding="4,0" Click="CalcBtn_Click"
                  AutomationProperties.Name="Calculator"
                  ToolTipService.ToolTip="Calculator — lengths in m or ft·in">
            <FontIcon FontFamily="{StaticResource HcwIconFont}" Glyph="&#xE8EF;" FontSize="14"
                      Foreground="{StaticResource HcwInkBrush}"/>
          </Button>
          <Button Content="Flush" Style="{StaticResource AadQuietButton}" Click="BridgeFlush_Click"
                  AutomationProperties.Name="Flush sync outbox"
                  ToolTipService.ToolTip="Flush firm.db outbox"/>
          <Border Padding="6,0" Height="22" CornerRadius="0"
                  Background="{StaticResource HcwFogBrush}"
                  ToolTipService.ToolTip="Activate only in AORMS Connect">
            <TextBlock x:Name="ConnectLicenceChip" Text="Licence"
                       AutomationProperties.Name="Licence status"
                       VerticalAlignment="Center" FontSize="10"
                       Foreground="{StaticResource HcwInkBrush}"
                       MaxWidth="100" TextTrimming="CharacterEllipsis"/>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Clock — smaller footprint, clears status strip -->
      <StackPanel x:Name="ClockPomodoroHost"
                  VerticalAlignment="Bottom" HorizontalAlignment="Right"
                  Margin="0,0,8,36" Spacing="2" Canvas.ZIndex="20"
                  AutomationProperties.Name="Clock and Pomodoro">
        <Viewbox Width="72" Height="72" Stretch="Uniform" HorizontalAlignment="Center">
          <Grid x:Name="PomodoroDial" Width="127" Height="127"
                ToolTipService.ToolTip="Pomodoro — click start/pause · double-click reset · drag crown">
            <Ellipse x:Name="PomodoroHitPlate" Width="127" Height="127"
                     Fill="#01F2F4F7" Stroke="Transparent"
                     Tapped="Pomodoro_Tapped" DoubleTapped="Pomodoro_DoubleTapped"/>
            <Grid x:Name="ClockFace" Width="100" Height="100" HorizontalAlignment="Center"
                  VerticalAlignment="Center" IsHitTestVisible="False">
              <Canvas Width="100" Height="100">
                <Line x:Name="ClockHour" X1="50" Y1="50" X2="50" Y2="28"
                      Stroke="{StaticResource HcwInkBrush}" StrokeThickness="3" StrokeLineJoin="Round"/>
                <Line x:Name="ClockMinute" X1="50" Y1="50" X2="50" Y2="18"
                      Stroke="{StaticResource HcwInkBrush}" StrokeThickness="2"/>
                <Line x:Name="ClockSecond" X1="50" Y1="50" X2="50" Y2="14"
                      Stroke="{StaticResource HcwAccentBrush}" StrokeThickness="1"/>
              </Canvas>
              <TextBlock Text="A" FontSize="12" FontWeight="Bold"
                         Foreground="{StaticResource HcwAccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Ellipse Width="116" Height="116" Stroke="#FFD4C4" StrokeThickness="2.4"
                     Fill="Transparent" IsHitTestVisible="False"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Path x:Name="PomodoroArc" Width="127" Height="127" Stretch="None"
                  Stroke="{StaticResource HcwAccentBrush}"
                  StrokeThickness="2.4" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" IsHitTestVisible="False"/>
            <Canvas x:Name="PomodoroCanvas" Width="127" Height="127" IsHitTestVisible="True">
              <Line x:Name="PomodoroArm" X1="63.5" Y1="63.5" X2="63.5" Y2="8"
                    Stroke="{StaticResource HcwAccentBrush}" StrokeThickness="1.2"
                    Opacity="0.9" IsHitTestVisible="False"/>
              <Ellipse x:Name="PomodoroCrownHit" Width="28" Height="28"
                       Fill="#01FFFFFF" Canvas.Left="49.5" Canvas.Top="-5"
                       PointerPressed="PomodoroCrown_PointerPressed"
                       PointerMoved="PomodoroCrown_PointerMoved"
                       PointerReleased="PomodoroCrown_PointerReleased"
                       PointerCaptureLost="PomodoroCrown_PointerReleased"/>
              <Ellipse x:Name="PomodoroCrown" Width="10" Height="10"
                       Fill="{StaticResource HcwAccentBrush}" Stroke="White" StrokeThickness="1"
                       Canvas.Left="58.5" Canvas.Top="3" IsHitTestVisible="False"/>
            </Canvas>
          </Grid>
        </Viewbox>
        <Button x:Name="PomodoroToggleBtn" Style="{StaticResource HcwGhostButton}"
                Height="22" MinHeight="22" MaxHeight="22" Padding="6,0"
                HorizontalAlignment="Center" Click="PomodoroToggle_Click">
          <TextBlock x:Name="PomodoroLabel" Text="25:00"
                     FontSize="10" FontWeight="SemiBold"
                     Foreground="{StaticResource HcwMutedBrush}"/>
        </Button>
      </StackPanel>

      <!-- Floating calculator — suite peer to AppFooterBar Calc; in-window panel -->
      <Border x:Name="CalcPanel" Width="280" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,12,40" Visibility="Collapsed" Padding="12,10" Canvas.ZIndex="65"
              Background="{StaticResource HcwWhiteBrush}"
              BorderBrush="{StaticResource HcwEdgeBrush}" BorderThickness="1"
              CornerRadius="0"
              AutomationProperties.Name="Calculator panel">
        <StackPanel Spacing="8">
          <Grid>
            <TextBlock Text="Calculator" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource HcwInkBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
              <ToggleButton x:Name="CalcImperialToggle" Content="m" Style="{StaticResource AadAidChip}"
                            Click="CalcUnit_Click"
                            AutomationProperties.Name="Feet and inches output"
                            ToolTipService.ToolTip="Toggle metric (m) / imperial (ft·in) result"/>
              <Button Content="×" Style="{StaticResource AadQuietButton}" MinWidth="28" Height="22"
                      Click="CalcClose_Click" AutomationProperties.Name="Close calculator"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="CalcResultText" Text="= 0 m" FontSize="28" FontFamily="Consolas"
                     Foreground="{StaticResource HcwAccentBrush}"
                     HorizontalAlignment="Right" TextWrapping="WrapWholeWords"
                     MinHeight="48" VerticalAlignment="Bottom"
                     AutomationProperties.Name="Calculator result"
                     AutomationProperties.LiveSetting="Polite"/>
          <TextBox x:Name="CalcExprBox" Height="28" FontSize="13" FontFamily="Consolas"
                   PlaceholderText="bare=metres · e.g. 3.2 + 1.5"
                   AutomationProperties.Name="Calculator expression"
                   TextChanged="CalcExpr_TextChanged"
                   KeyDown="CalcExpr_KeyDown"/>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="C" Style="{StaticResource AadQuietButton}" MinWidth="36" Height="24"
                    Click="CalcClear_Click" ToolTipService.ToolTip="Clear"/>
            <Button Content="(" Style="{StaticResource AadQuietButton}" MinWidth="32" Height="24"
                    Click="CalcKey_Click" Tag="("/>
            <Button Content=")" Style="{StaticResource AadQuietButton}" MinWidth="32" Height="24"
                    Click="CalcKey_Click" Tag=")"/>
            <Button Content="÷" Style="{StaticResource AadQuietButton}" MinWidth="32" Height="24"
                    Click="CalcKey_Click" Tag="/"/>
            <Button Content="×" Style="{StaticResource AadQuietButton}" MinWidth="32" Height="24"
                    Click="CalcKey_Click" Tag="*"/>
            <Button Content="−" Style="{StaticResource AadQuietButton}" MinWidth="32" Height="24"
                    Click="CalcKey_Click" Tag="-"/>
            <Button Content="+" Style="{StaticResource AadQuietButton}" MinWidth="32" Height="24"
                    Click="CalcKey_Click" Tag="+"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="ToolsPane" Width="260" HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Margin="0,0,28,32"
              Background="{StaticResource HcwWhiteBrush}"
              BorderBrush="{StaticResource HcwEdgeBrush}" BorderThickness="1"
              Visibility="Collapsed" Padding="10,8" Canvas.ZIndex="60">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Tools" FontWeight="SemiBold" FontSize="13"
                     Foreground="{StaticResource HcwInkBrush}"/>
          <ListView x:Name="ToolsList" Grid.Row="1" Margin="0,6,0,0"
                    SelectionMode="Single" IsItemClickEnabled="True"
                    ItemClick="ToolsList_ItemClick"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
